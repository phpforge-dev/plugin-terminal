{
  "id": "phpforge.terminal",
  "name": "Terminal",
  "version": "1.0.1",
  "minIdeVersion": "0.2.13",
  "main": "main.js",
  "description": "terminal workbench integration with explicit host services.",
  "activation": {
    "languages": []
  },
  "permissions": [
    "project.read",
    "workbench",
    "process"
  ],
  "workbench": {
    "apiVersion": 1,
    "main": "workbench.js",
    "style": "workbench.css",
    "services": [
      "dockerTerminal",
      "onTerminalEvent",
      "terminalAck",
      "terminalClose",
      "terminalCreate",
      "terminalResize",
      "terminalWrite"
    ]
  }
}
